# Copy to .env for local IntelliJ runs or Docker Compose; set your own values.
# Use Java Properties KEY=value syntax; do not add quotes or an `export` prefix.
ADMIN_LOGIN_ID=
ADMIN_INITIAL_PASSWORD=
SERVER_PORT=8080
DOCKER_SERVER_PORT=8081
MOBILE_TOKEN_TTL=PT12H
# Shared database used by Docker and IntelliJ. Keep these values aligned with .env.
POSTGRES_DB=workersafety
POSTGRES_USER=workersafety
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/workersafety
SPRING_DATASOURCE_USERNAME=workersafety
SPRING_DATASOURCE_PASSWORD=change-this-local-password
# Docker profile: use local for HTTP development or prod behind HTTPS.
SPRING_PROFILES_ACTIVE=local
